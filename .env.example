# Variaveis de ambiente da API do Frota+ em PRODUCAO.
# Este arquivo e so um modelo: todos os valores abaixo sao FICTICIOS.
# Cadastre os valores reais no painel de segredos da hospedagem, nunca no Git.
# Detalhes: docs/DEPLOYMENT_PRODUCTION.md

# --- Obrigatorias (sem elas a API nao sobe) ---
SPRING_PROFILES_ACTIVE=prod
# Banco EXCLUSIVO de producao. O perfil prod recusa bancos com "test",
# "integracao" ou "descartavel" no nome.
DB_URL=jdbc:postgresql://HOST-FICTICIO.exemplo.test:5432/frotamais_producao?sslmode=require
DB_USER=usuario_ficticio
DB_PASSWORD=TROQUE-PELA-SENHA-REAL
# Chave HS256 em Base64, com pelo menos 32 bytes, NOVA para producao
# (nunca a de desenvolvimento). Gere com: openssl rand -base64 48
JWT_SECRET=VALOR-FICTICIO-GERE-UM-NOVO
# Origem https EXATA do front-end (sem barra final, sem caminho). Varias:
# separadas por virgula. Nunca "*".
CORS_ORIGENS_PERMITIDAS=https://frontend-ficticio.exemplo.test

# --- Opcionais ---
# Porta HTTP (muitas hospedagens definem PORT sozinhas). Padrao: 8080.
PORT=8080
# Validade do token de login, em horas (1 a 24). Padrao: 8.
JWT_HORAS=8

# --- Convites de motorista por e-mail (sem elas: convites respondem 503) ---
EMAIL_REMETENTE=nao-responda@exemplo.test
# Tela de ativacao do front-end; o token vai como parametro ?token=
CONVITE_URL_ATIVACAO=https://frontend-ficticio.exemplo.test/ativar
CONVITE_VALIDADE_HORAS=24
SPRING_MAIL_HOST=smtp.exemplo.test
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=usuario-smtp-ficticio
SPRING_MAIL_PASSWORD=TROQUE-PELA-SENHA-SMTP
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# NUNCA em producao: EMAIL_CAPTURA_LOCAL / EMAIL_CAPTURA_DIR (so perfil dev;
# a API recusa subir com elas fora do dev).
